# --- scrape 内的杂项（仅 Worker 源码 + 必要配置已显式 git add） ---
scrape/_*
scrape/probe_*.mjs
scrape/*.csv
scrape/*.png
scrape/*.pdf
scrape/*.html
scrape/*.log
scrape/*.md
scrape/*.json
# 例外（Worker 可能需要）；注释须独立成行，gitignore 只认行首 # 为注释
!scrape/comm_register.json
!scrape/package.json
scrape/*.txt
!scrape/cmbwm_pubkey.txt     # SM2 公钥，Worker 需要
scrape/worker.js.备份-*
scrape/cmbwm_profile/

